# Credenciales IOL
IOL_USERNAME=
IOL_PASSWORD=

# URL base de la API de IOL
# Sandbox (desarrollo):  https://api.homo.invertironline.com
# Producción:            https://api.invertironline.com
IOL_BASE_URL=https://api.homo.invertironline.com

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/iol_trading

# Entorno de ejecución (development | production)
NODE_ENV=development

# Intervalo de polling en milisegundos (default: 30 segundos)
POLL_INTERVAL_MS=30000
