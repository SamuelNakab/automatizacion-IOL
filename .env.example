# ── IOL ──────────────────────────────────────────────
IOL_USERNAME=
IOL_PASSWORD=
IOL_BASE_URL=

# ── Base de datos ─────────────────────────────────────
# Pooler URL (para runtime del bot)
DATABASE_URL=
# Direct URL (para migrations de Prisma)
DIRECT_URL=
# ── Bot config ────────────────────────────────────────
NODE_ENV=development
INITIAL_CAPITAL=10000
DRY_RUN=true

# ── Mercado ───────────────────────────────────────────
MARKET_OPEN_HOUR=11
MARKET_CLOSE_HOUR=17
ORPHAN_ORDER_TIMEOUT_MIN=30
ORDER_POLL_INTERVAL_MS=60000
POLL_INTERVAL_MS=300000

# ── Risk Manager ──────────────────────────────────────
RISK_MAX_CAPITAL_PER_TRADE_PCT=10
RISK_MAX_EXPOSURE_PER_ASSET_PCT=20
RISK_MAX_TOTAL_EXPOSURE_PCT=60
RISK_MAX_DRAWDOWN_PCT=15
RISK_MIN_OPERATION_INTERVAL_MINUTES=60

# ── Monitoring HTTP ───────────────────────────────────
MONITORING_PORT=3001

# ── Alertas email ─────────────────────────────────────
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=
ALERT_ON_ORDER=true
ALERT_DRAWDOWN_PCT=10

# ── Dashboard ─────────────────────────────────────────
DASHBOARD_URL=

# ── WhatsApp (Twilio) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# ── Algoritmo de compra ───────────────────────────────
BUY_SIGNAL_THRESHOLD=6
BUY_ZSCORE_THRESHOLD=-1.5
BUY_RSI_OVERSOLD=35
BUY_RSI_EXTREME=25
BUY_INTRADAY_WINDOW_HOURS=2

# ── Algoritmo de venta ────────────────────────────────
TAKE_PROFIT_PCT=8