# Credenciales IOL
IOL_USERNAME=
IOL_PASSWORD=

# URL base de la API de IOL

IOL_BASE_URL=https://api.invertironline.com

# Base de datos PostgreSQL
# Pooler (para queries de runtime — usar con DATABASE_URL)
DATABASE_URL=
# Conexión directa (para prisma migrate — Neon pooler no soporta DDL)
# En Neon: igual que DATABASE_URL pero sin "-pooler" en el hostname
DIRECT_URL=

# Entorno de ejecución (development | production)
NODE_ENV=development
DRY_RUN=true
# Intervalo de polling en milisegundos (default: 30 segundos)
POLL_INTERVAL_MS=30000

INITIAL_CAPITAL=

# Risk Manager — límites de riesgo (todos opcionales, se usan los defaults si no se definen)
RISK_MAX_CAPITAL_PER_TRADE_PCT=10       # Máximo % del capital disponible por operación
RISK_MAX_EXPOSURE_PER_ASSET_PCT=20      # Máximo % del capital total en un solo activo
RISK_MAX_TOTAL_EXPOSURE_PCT=60          # Máximo % del capital total en posiciones abiertas
RISK_MAX_DRAWDOWN_PCT=15                # Si drawdown supera este %, solo se permiten ventas
RISK_MIN_OPERATION_INTERVAL_MINUTES=60  # Mínimo de minutos entre operaciones del mismo activo