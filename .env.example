# ── IOL ──────────────────────────────────────────────
IOL_USERNAME=
IOL_PASSWORD=
IOL_BASE_URL=https://api.invertironline.com

# ── Base de datos ─────────────────────────────────────
DATABASE_URL=

DIRECT_URL

# ── Bot config ────────────────────────────────────────
NODE_ENV=development
INITIAL_CAPITAL=
POLL_INTERVAL_MS=30000
DRY_RUN=true

# ── Risk Manager ──────────────────────────────────────
RISK_MAX_CAPITAL_PER_TRADE_PCT=10
RISK_MAX_EXPOSURE_PER_ASSET_PCT=20
RISK_MAX_TOTAL_EXPOSURE_PCT=60
RISK_MAX_DRAWDOWN_PCT=15
RISK_MIN_OPERATION_INTERVAL_MINUTES=60

# ── Mercado ───────────────────────────────────────────
MARKET_OPEN_HOUR=10
MARKET_CLOSE_HOUR=17
ORPHAN_ORDER_TIMEOUT_MIN=30
ORDER_POLL_INTERVAL_MS=60000

# ── Monitoring HTTP ───────────────────────────────────
MONITORING_PORT=3001

# ── Alertas email (Fase 7A) ───────────────────────────
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=        # App password de Google, no tu contraseña real
ALERT_ON_ORDER=true
ALERT_DRAWDOWN_PCT=10

# ── Dashboard (Fase 7B) ───────────────────────────────
DASHBOARD_URL=               # URL de Vercel cuando esté deployado